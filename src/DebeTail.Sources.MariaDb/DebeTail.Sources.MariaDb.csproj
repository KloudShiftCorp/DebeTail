<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>KloudShift.DebeTail.Sources.MariaDb</RootNamespace>
    <PackageId>DebeTail.Sources.MariaDb</PackageId>
    <Description>MySQL and MariaDB binlog source connector for DebeTail.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlCdc" Version="4.0.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DebeTail.Abstractions\DebeTail.Abstractions.csproj" />
    <ProjectReference Include="..\DebeTail.Pipeline\DebeTail.Pipeline.csproj" />
  </ItemGroup>

</Project>
