<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>DebeTail.Sinks.Console</PackageId>
    <RootNamespace>KloudShift.DebeTail.Sinks.Console</RootNamespace>
    <Description>Console (stdout) sink for DebeTail. Writes serialized change envelopes to stdout. Suitable for local development and containerised deployments using stdout log aggregation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DebeTail.Abstractions\DebeTail.Abstractions.csproj"/>
    <ProjectReference Include="..\DebeTail.Pipeline\DebeTail.Pipeline.csproj"/>
  </ItemGroup>

</Project>