<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>DebeTail.Pipeline</PackageId>
    <RootNamespace>KloudShift.DebeTail.Pipeline</RootNamespace>
    <Description>Pipeline execution engine for DebeTail. Provides the fluent CdcPipeline builder, async event loop, batching, offset tracking, and DI registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DebeTail.Abstractions\DebeTail.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
