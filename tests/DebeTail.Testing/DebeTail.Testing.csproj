<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>KloudShift.DebeTail.Testing</RootNamespace>
    <Description>Framework-agnostic test doubles and builders for DebeTail pipelines. Works with xUnit, NUnit, MSTest, or no framework at all.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DebeTail.Abstractions\DebeTail.Abstractions.csproj" />
  </ItemGroup>

</Project>
